# OpenAI (STT + LLM)
OPENAI_API_KEY=sk-...

# LLM/STT models
LLM_MODEL=gpt-4o
STT_MODEL=gpt-4o-transcribe

# ha-character-bridge WebSocket (AITuber Kit への中継)
HA_CHAR_BRIDGE_WS_URL=ws://127.0.0.1:8000/ws

# ha-bridge HTTP (Home Assistant 操作)
HA_BRIDGE_URL=http://127.0.0.1:18088

# Wake word
# 複数指定する場合はカンマ区切り
WAKEWORD_MODEL_PATHS=../voice-listener/models/Hey_Kemy.onnx
WAKE_THRESHOLD=0.5
WAKE_CONFIRM_CHUNKS=2
# Wake word 検出後に VAD+STT を有効にする秒数
WAKE_ACTIVE_WINDOW=8.0

# マイク設定 (空=デフォルトデバイス)
MIC_DEVICE_INDEX=
# マイクゲイン倍率
MIC_GAIN=1.0

# デバッグ: 最後の録音を保存するパス (空=保存しない)
LAST_WAV_PATH=/tmp/pipecat-last.wav
