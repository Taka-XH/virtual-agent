# ============================================================
# STT バックエンド選択
# openai  (推奨・高精度・CER=1.2%・batch・約880ms)
# deepgram (高速・streaming・約250ms・ただし日本語CER=57-65%と精度が低い)
# ============================================================
STT_BACKEND=openai

# Deepgram API キー (STT_BACKEND=deepgram のとき必須)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# OpenAI API キー (STT_BACKEND=openai のとき、または LLM_BACKEND=openai のとき必須)
OPENAI_API_KEY=sk-...

# OpenAI STT モデル (STT_BACKEND=openai のときのみ使用)
# bench_accuracy.py 結果: gpt-4o-mini-transcribe と gpt-4o-transcribe は同精度 (CER=1.2%)
# コスト効率で gpt-4o-mini-transcribe を推奨
STT_MODEL=gpt-4o-mini-transcribe

# ============================================================
# LLM バックエンド選択
# groq   (推奨・TTFT ~150ms・bench_accuracy.py 結果: HA精度100%)
# openai (高品質・TTFT ~640ms・ただし gpt-4o は短い命令でHA精度67%に低下)
# ============================================================
LLM_BACKEND=groq

# OpenAI LLM モデル (LLM_BACKEND=openai)
# bench_accuracy.py 結果: gpt-4o-mini が gpt-4o を上回る (100% vs 67% HA精度)
LLM_MODEL=gpt-4o-mini

# Groq API キー (LLM_BACKEND=groq のとき必須)
# https://console.groq.com/
GROQ_API_KEY=
# Groq モデル: llama-3.3-70b-versatile (日本語品質重視) | llama-3.1-8b-instant (速度重視)
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# AITuber Kit / ha-character-bridge
# ============================================================
HA_CHAR_BRIDGE_WS_URL=ws://127.0.0.1:8000/ws

# ha-bridge HTTP (Home Assistant 操作)
HA_BRIDGE_URL=http://127.0.0.1:18088

# ============================================================
# Wake word
# ============================================================
WAKEWORD_MODEL_PATHS=../voice-listener/models/Hey_Kemy.onnx
WAKE_THRESHOLD=0.5
# 2チャンクで確認 (80ms×2=160ms) — 誤検知 vs 速度のバランス
WAKE_CONFIRM_CHUNKS=2
WAKE_ACTIVE_WINDOW=8.0

# ============================================================
# マイク
# ============================================================
MIC_DEVICE_INDEX=

# ============================================================
# Deepgram チューニング (STT_BACKEND=deepgram)
# ============================================================
# 発話後の無音時間(ms)でエンドポイント判定
DEEPGRAM_ENDPOINTING_MS=300
# 最大無音時間(ms)でUtteranceEnd発火
DEEPGRAM_UTTERANCE_END_MS=1000
# nova-3-general (新) | nova-2-general (旧・日本語実績あり)
DEEPGRAM_MODEL=nova-3-general

# ============================================================
# VAD チューニング (SileroVAD)
# ============================================================
# 発話開始判定の最低継続秒数 (0.1〜0.3)
VAD_START_SECS=0.2
# 発話終了判定の無音秒数 (0.1〜0.5) — 旧voice-listenerは0.9s
VAD_STOP_SECS=0.2
# 音声検出の信頼度閾値 (0.5〜0.9)
VAD_CONFIDENCE=0.7
