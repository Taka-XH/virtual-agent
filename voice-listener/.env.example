OPENAI_API_KEY=
INTERACTION_BRIDGE_URL=http://127.0.0.1:18089
STT_MODEL=gpt-4o-transcribe
STT_PROMPT=日本語の短い音声です。聞き取れない場合は無理に推測しないでください。
LOG_TIMINGS=true
WAKE_THRESHOLD=0.82
MIC_DEVICE_INDEX=1
MIC_GAIN=1.8
WAKEWORD_MODEL_PATHS=models/Hey_Kemy.onnx
ACCEPT_WAKE_WORDS=Hey_Kemy
WAKE_ACK_ENABLED=false
MIN_RECORD_SECONDS=0.7
MIN_AUDIO_RMS=0.006
MIN_AUDIO_PEAK=0.05
MIN_SPEECH_SECONDS=0.35
VAD_AGGRESSIVENESS=3
VAD_START_FRAMES=4
MAX_RECORD_SECONDS=15
START_PADDING_SECONDS=0.4
END_SILENCE_SECONDS=0.9
LAST_WAV_PATH=/tmp/voice-listener-last.wav
COMMAND_COOLDOWN_SECONDS=2.0
FALSE_WAKE_COOLDOWN_SECONDS=1.5
FOLLOW_UP_ENABLED=true
FOLLOW_UP_MAX_TURNS=2
FOLLOW_UP_RECORD_SECONDS=8
FOLLOW_UP_COOLDOWN_SECONDS=0.4
WAKE_CONFIRM_CHUNKS=1
WAKE_RESET_THRESHOLD=0.62
WAKE_DEBOUNCE_SECONDS=2.0
REPEAT_TEXT_IGNORE_SECONDS=3.0
